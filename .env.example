# ---- Core -------------------------------------------------------------
# Public URL of the deployment (no trailing slash). Used for OAuth redirect + CSRF origin checks.
APP_URL=http://localhost:5173
# PostgreSQL connection string (Supabase/Neon/any Postgres 14+). Add ?sslmode=require for hosted DBs.
DATABASE_URL=postgres://fluent:password@127.0.0.1:5432/fluent
# require | disable | auto (auto = TLS for non-localhost hosts)
DATABASE_SSL=auto
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI (Vercel AI SDK) -------------------------------------------------
# google | xai | openai. Leave empty to auto-select: the Gemini key wins, then xAI, then OpenAI.
AI_PROVIDER=
# Optional model override. Defaults: google -> gemini-3.5-flash-lite, xai -> grok-4.7, openai -> gpt-4.1-mini
AI_MODEL=
# Google AI Studio key (https://aistudio.google.com/apikey). The free tier lets Google use prompts
# to improve its products: use a paid (billing-enabled) key before real users' email goes through it.
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# ---- Optional -----------------------------------------------------------
LOG_LEVEL=info
SESSION_TTL_DAYS=30
